{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asterion Terminal",
  "version": "0.1.0",
  "identifier": "me.asterion.terminal",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星枢 · Asterion Terminal",
        "width": 1440,
        "height": 940,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/asterion-trading",
      "binaries/asterion-node-agent",
      "binaries/asterion-market-data",
      "binaries/asterion-task-service",
      "binaries/asterion-backtest",
      "binaries/asterion-factor",
      "binaries/asterion-data-pipeline",
      "binaries/asterion-strategy"
    ],
    "resources": {
      "resources/native/": "native/",
      "resources/remote-linux/x86_64/": "remote-linux/x86_64/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
