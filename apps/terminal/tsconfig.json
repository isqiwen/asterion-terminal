{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../presentation/*/src/**/*.ts",
    "../../presentation/*/src/**/*.tsx",
    "../../presentation/panels/*/src/**/*.ts",
    "../../presentation/panels/*/src/**/*.tsx",
    "../../products/terminal/src/**/*.ts",
    "../../products/terminal/src/**/*.tsx",
    "../../bindings/typescript/src/**/*.ts"
  ]
}
