{
  "console": {
    "enabled": false,
    "level": "info",
    "pattern": "[%Y-%m-%d %H:%M:%S.%e %z] [%l] [%n] [%s:%#] %v"
  },
  "file": {
    "enabled": true,
    "level": "info",
    "path": "../logs/{program}-{pid}.log",
    "retention_days": 30,
    "pattern": "[%Y-%m-%d %H:%M:%S.%e %z] [%l] [%n] [%s:%#] %v"
  }
}
