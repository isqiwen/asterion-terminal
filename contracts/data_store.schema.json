{
  "$defs": {
    "Cell": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "A stored scalar. Current partitions hold strings (dates, decimals and\nidentifiers), integers and nulls; any other value is rejected, not coerced."
    },
    "CoverageGap": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "MergeRequest": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 126,
          "minItems": 1,
          "type": "array"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParentVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "primary_key": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "raw_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/Cell"
            },
            "type": "array"
          },
          "maxItems": 1000000,
          "minItems": 1,
          "type": "array"
        },
        "time_field": {
          "type": "string"
        },
        "type_id": {
          "type": "string"
        }
      },
      "required": [
        "columns",
        "job_id",
        "observed_at",
        "parent",
        "primary_key",
        "raw_version_id",
        "rows",
        "time_field",
        "type_id"
      ],
      "type": "object"
    },
    "ParentVersion": {
      "additionalProperties": false,
      "properties": {
        "coverage_gaps": {
          "items": {
            "$ref": "#/$defs/CoverageGap"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "first": {
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "index": {
          "$ref": "#/$defs/PartitionedVersion"
        },
        "last": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "coverage_gaps",
        "first",
        "id",
        "index",
        "last",
        "observed_at",
        "revision"
      ],
      "type": "object"
    },
    "Partition": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "checksum": {
          "type": "string"
        },
        "first": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "replaces": {
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bytes",
        "checksum",
        "first",
        "inputs",
        "key",
        "last",
        "replaces",
        "rows"
      ],
      "type": "object"
    },
    "PartitionedVersion": {
      "additionalProperties": false,
      "description": "The recorded location and content of a partitioned version's index.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "checksum": {
          "type": "string"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/Partition"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "checksum",
        "partitions",
        "path"
      ],
      "type": "object"
    },
    "ScanRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_rows": {
          "default": 1024,
          "format": "uint",
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "contract_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "end": {
          "format": "date",
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        },
        "version_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "contract_ids",
        "start",
        "end",
        "columns"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ScanRequest"
    },
    {
      "$ref": "#/$defs/Cell"
    },
    {
      "$ref": "#/$defs/Partition"
    },
    {
      "$ref": "#/$defs/PartitionedVersion"
    },
    {
      "$ref": "#/$defs/CoverageGap"
    },
    {
      "$ref": "#/$defs/ParentVersion"
    },
    {
      "$ref": "#/$defs/MergeRequest"
    }
  ],
  "title": "Models"
}
