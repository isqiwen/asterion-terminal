{
  "$defs": {
    "Channel": {
      "enum": [
        "market",
        "account"
      ],
      "type": "string"
    },
    "ChannelState": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "尚未连接",
          "type": "string"
        },
        "generation": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ConnectionStatus",
          "default": "disconnected"
        }
      },
      "type": "object"
    },
    "ConfigField": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": "",
          "type": "string"
        },
        "identity": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "type": "object"
    },
    "ConnectionProfile": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "config_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "connection_id": {
          "type": "string"
        },
        "connector_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "connector_id",
        "name",
        "config_revision",
        "config"
      ],
      "type": "object"
    },
    "ConnectionStatus": {
      "enum": [
        "disconnected",
        "connecting",
        "authenticating",
        "ready",
        "reconnecting",
        "error"
      ],
      "type": "string"
    },
    "ConnectorDescriptor": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ConfigField"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "instructions": {
          "default": "",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner",
        "title",
        "capabilities",
        "fields"
      ],
      "type": "object"
    },
    "Exchange": {
      "enum": [
        "SHFE",
        "DCE",
        "CZCE",
        "CFFEX",
        "INE",
        "GFEX"
      ],
      "type": "string"
    },
    "Feature": {
      "enum": [
        "market_quotes",
        "instrument_catalog",
        "account_snapshot",
        "positions"
      ],
      "type": "string"
    },
    "ReadBatch": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "const": true,
          "type": "boolean"
        },
        "connection_id": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observed_at": {
          "format": "double",
          "type": "number"
        },
        "request_id": {
          "type": "string"
        },
        "started_at": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "connection_id",
        "generation",
        "request_id",
        "started_at",
        "observed_at",
        "complete"
      ],
      "type": "object"
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "request_id": {
          "type": "string"
        },
        "started_at": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "connection_id",
        "generation",
        "request_id",
        "started_at"
      ],
      "type": "object"
    },
    "Subscription": {
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "$ref": "#/$defs/Exchange"
        },
        "symbol": {
          "type": "string"
        }
      },
      "required": [
        "exchange",
        "symbol"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "channel_state": {
      "$ref": "#/$defs/ChannelState"
    },
    "connector": {
      "$ref": "#/$defs/ConnectorDescriptor"
    },
    "field": {
      "$ref": "#/$defs/ConfigField"
    },
    "profile": {
      "$ref": "#/$defs/ConnectionProfile"
    },
    "read_batch": {
      "$ref": "#/$defs/ReadBatch"
    },
    "read_request": {
      "$ref": "#/$defs/ReadRequest"
    },
    "subscription": {
      "$ref": "#/$defs/Subscription"
    }
  },
  "required": [
    "subscription",
    "field",
    "connector",
    "profile",
    "channel",
    "channel_state",
    "read_request",
    "read_batch"
  ],
  "title": "Models",
  "type": "object"
}
