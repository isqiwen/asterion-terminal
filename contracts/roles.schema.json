{
  "$defs": {
    "AvailabilityBasis": {
      "enum": [
        "local_observation"
      ],
      "type": "string"
    },
    "CalendarDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "is_open": {
          "type": "boolean"
        },
        "night_open": {
          "type": "boolean"
        }
      },
      "required": [
        "date",
        "is_open",
        "night_open"
      ],
      "type": "object"
    },
    "CatalogInput": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "version_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "checksum",
        "source"
      ],
      "type": "object"
    },
    "ComputedAssignment": {
      "additionalProperties": false,
      "description": "Algorithm-neutral projection of a published computation. It contains no\nranking policy, candidates, scores or executable algorithm artifact.",
      "properties": {
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "effective_day": {
          "format": "date",
          "type": "string"
        },
        "effective_start": {
          "format": "date-time",
          "type": "string"
        },
        "main": {
          "minLength": 1,
          "type": "string"
        },
        "secondary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "effective_day",
        "effective_start",
        "available_at",
        "main",
        "secondary"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "ComputedRoleIndex": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/ReferenceCatalog"
        },
        "product_id": {
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ComputedAssignment"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "trading_time": {
          "$ref": "#/$defs/TimeVersion"
        },
        "version_id": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "product_id",
        "catalog",
        "trading_time",
        "published_at",
        "records"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "ComputedRoleResolution": {
      "additionalProperties": false,
      "properties": {
        "availability_basis": {
          "$ref": "#/$defs/AvailabilityBasis"
        },
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/Contract"
        },
        "execution_authorized": {
          "const": false,
          "type": "boolean"
        },
        "historical_publication_attested": {
          "const": false,
          "type": "boolean"
        },
        "record_index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/Span"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "contract",
        "record_index",
        "session",
        "available_at",
        "availability_basis",
        "historical_publication_attested",
        "execution_authorized"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "Contract": {
      "additionalProperties": false,
      "properties": {
        "delivery_month": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "last_delivery_on": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "last_trade_on": {
          "format": "date",
          "type": "string"
        },
        "listed_on": {
          "format": "date",
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "product_id",
        "delivery_month",
        "listed_on",
        "last_trade_on",
        "provenance",
        "last_delivery_on"
      ],
      "type": "object"
    },
    "ExceptionDay": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "maxItems": 20,
          "type": "array"
        },
        "night": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "maxItems": 20,
          "type": "array"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "trading_day": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "trading_day",
        "source",
        "day",
        "night"
      ],
      "type": "object"
    },
    "Exchange": {
      "enum": [
        "SHFE",
        "DCE",
        "CZCE",
        "CFFEX",
        "INE",
        "GFEX"
      ],
      "type": "string"
    },
    "Exchange2": {
      "enum": [
        "SHFE",
        "DCE",
        "CZCE",
        "CFFEX",
        "INE",
        "GFEX"
      ],
      "type": "string"
    },
    "NextOpening": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "observation_end": {
          "format": "date-time",
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "trading_time": {
          "$ref": "#/$defs/TimeVersion"
        }
      },
      "required": [
        "product_id",
        "trading_time",
        "observation_end",
        "available_at"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "end": {
          "format": "date",
          "type": "string"
        },
        "night": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "maxItems": 20,
          "type": "array"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "source",
        "day",
        "night"
      ],
      "type": "object"
    },
    "Phase": {
      "enum": [
        "auction",
        "continuous"
      ],
      "type": "string"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange"
        },
        "id": {
          "pattern": "^(SHFE|DCE|CZCE|CFFEX|INE|GFEX)\\.[A-Z]+$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "exchange",
        "name",
        "currency",
        "provenance"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_version",
        "observed_at",
        "available_at"
      ],
      "type": "object"
    },
    "ReferenceCatalog": {
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "items": {
            "$ref": "#/$defs/Contract"
          },
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/CatalogInput"
          },
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/Product"
          },
          "type": "array"
        },
        "schema_version": {
          "format": "uint8",
          "maximum": 2,
          "minimum": 2,
          "type": "integer"
        },
        "symbols": {
          "items": {
            "$ref": "#/$defs/SourceSymbol"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "inputs",
        "products",
        "contracts",
        "symbols"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "main",
        "secondary"
      ],
      "type": "string"
    },
    "RoleCalendar": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string"
        },
        "trading_time": {
          "$ref": "#/$defs/TimeVersion"
        }
      },
      "required": [
        "product_id",
        "trading_time"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "RoleMode": {
      "enum": [
        "as_known",
        "retrospective"
      ],
      "type": "string"
    },
    "RoleOrigin": {
      "enum": [
        "provider_report"
      ],
      "type": "string"
    },
    "RoleQuery": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 2000,
          "type": "string"
        },
        "information_at": {
          "format": "date-time",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RoleMode"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "version_id": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "role",
        "timestamp",
        "information_at",
        "mode",
        "explanation"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "RoleReport": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "contract_id": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "trading_day": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "trading_day",
        "role",
        "contract_id",
        "evidence",
        "available_at"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "RoleResolution": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "$ref": "#/$defs/Contract"
        },
        "execution_authorized": {
          "const": false,
          "type": "boolean"
        },
        "explanation": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RoleMode"
        },
        "report": {
          "$ref": "#/$defs/RoleReport"
        },
        "session": {
          "$ref": "#/$defs/Span"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "contract",
        "report",
        "session",
        "mode",
        "explanation",
        "execution_authorized"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "RoleSpec": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/ReferenceCatalog"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/RoleOrigin"
        },
        "product_id": {
          "type": "string"
        },
        "reports": {
          "items": {
            "$ref": "#/$defs/RoleReport"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "source_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_version": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "trading_time": {
          "$ref": "#/$defs/TimeVersion"
        }
      },
      "required": [
        "schema_version",
        "origin",
        "source",
        "source_version",
        "source_checksum",
        "observed_at",
        "product_id",
        "catalog",
        "trading_time",
        "reports"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "RoleVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/RoleSpec"
        }
      },
      "required": [
        "id",
        "spec"
      ],
      "type": "object",
      "x-strip-whitespace": true
    },
    "Session": {
      "enum": [
        "day",
        "night"
      ],
      "type": "string"
    },
    "Slot": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
          "type": "string"
        },
        "end_offset": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 0,
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "start": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "end_offset",
        "phase"
      ],
      "type": "object"
    },
    "SourceSymbol": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S+$",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "type": "string"
        },
        "valid_until": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "source",
        "symbol",
        "contract_id",
        "valid_from",
        "valid_until",
        "provenance"
      ],
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        },
        "trading_day": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "trading_day",
        "session",
        "phase"
      ],
      "type": "object"
    },
    "TimeSpec": {
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "items": {
            "$ref": "#/$defs/CalendarDay"
          },
          "maxItems": 3700,
          "minItems": 2,
          "type": "array"
        },
        "calendar_source": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "exceptions": {
          "items": {
            "$ref": "#/$defs/ExceptionDay"
          },
          "maxItems": 200,
          "type": "array"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange2"
        },
        "night_source": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        },
        "product": {
          "maxLength": 20,
          "pattern": "^[A-Z]+$",
          "type": "string"
        },
        "schema_version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "timezone": {
          "pattern": "^Asia/Shanghai$",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "exchange",
        "product",
        "title",
        "timezone",
        "calendar_source",
        "night_source",
        "calendar",
        "periods",
        "exceptions"
      ],
      "type": "object"
    },
    "TimeVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/TimeSpec"
        }
      },
      "required": [
        "id",
        "spec"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/RoleReport"
    },
    {
      "$ref": "#/$defs/RoleSpec"
    },
    {
      "$ref": "#/$defs/RoleVersion"
    },
    {
      "$ref": "#/$defs/RoleQuery"
    },
    {
      "$ref": "#/$defs/RoleResolution"
    },
    {
      "$ref": "#/$defs/RoleCalendar"
    },
    {
      "$ref": "#/$defs/NextOpening"
    },
    {
      "$ref": "#/$defs/ComputedAssignment"
    },
    {
      "$ref": "#/$defs/ComputedRoleIndex"
    },
    {
      "$ref": "#/$defs/ComputedRoleResolution"
    }
  ],
  "title": "Models"
}
