{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asterion:communication:1",
  "$defs": {
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "correlation_id",
        "causation_id",
        "deadline_ms"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "correlation_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 32,
          "maxLength": 32
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "kind",
        "contract",
        "payload"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/Context"
        },
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "query"
          ]
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "Fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "Reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "result",
        "error"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/Context"
        },
        "result": {},
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fault"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "topic",
        "owner",
        "stream",
        "sequence",
        "correlation_id",
        "causation_id",
        "payload"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "correlation_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 32,
          "maxLength": 32
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      }
    }
  }
}
