{
  "name": "asterion-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --config apps/clients/terminal/vite.config.ts",
    "build": "tsc --noEmit -p apps/clients/terminal/tsconfig.json && vite build --config apps/clients/terminal/vite.config.ts",
    "test:e2e": "python3 tests/ssh_e2e.py pnpm exec playwright test --config apps/clients/terminal/playwright.config.ts",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:check": "node scripts/desktop.mjs check",
    "format": "prettier --write \"apps/clients/terminal/**/*.{ts,tsx,css,json,cjs}\" scripts/desktop.mjs scripts/electron-dev.cjs tests/electron*.cjs \"packages/client-ui/**/*.{ts,tsx,css,json}\" && python3 scripts/format_cpp.py",
    "format:check": "prettier --check \"apps/clients/terminal/**/*.{ts,tsx,css,json,cjs}\" scripts/desktop.mjs scripts/electron-dev.cjs tests/electron*.cjs \"packages/client-ui/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint \"apps/clients/**/*.{ts,tsx}\" \"packages/client-ui/**/*.{ts,tsx}\" --max-warnings 0",
    "test:desktop": "node tests/electron_desktop.cjs && node tests/electron_depth.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.20.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "node-gyp": "13.0.2",
    "prettier": "^3.9.9",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0"
  }
}
