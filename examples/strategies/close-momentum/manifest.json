{
  "api_version": 1,
  "id": "example.close_momentum",
  "version": "1.1.0",
  "title": "收盘动量示例",
  "description": "独立策略包：逐根收盘输入，按回看周期产生做多或空仓意图。",
  "runtime": "python",
  "entry": "plugin.py",
  "trust": "local-code",
  "contributions": {
    "research.strategy": {
      "id": "example.close_momentum",
      "name": "收盘动量示例",
      "description": "按回看涨幅、阈值和比较方式产生做多/空仓意图；开关关闭时保持空仓。",
      "data_type": "futures.daily",
      "execution": "long-flat-next-open",
      "dependencies": "stdlib-and-sdk",
      "parameters": [
        {
          "key": "lookback",
          "label": "回看周期",
          "type": "integer",
          "minimum": 1,
          "maximum": 499,
          "default": 10
        },
        {
          "key": "threshold",
          "label": "涨幅阈值",
          "type": "decimal",
          "minimum": "0",
          "maximum": "1",
          "scale": 4,
          "default": "0.0000"
        },
        {
          "key": "enabled",
          "label": "允许做多",
          "type": "boolean",
          "default": true
        },
        {
          "key": "comparison",
          "label": "阈值比较",
          "type": "enum",
          "choices": [
            {
              "value": "strict",
              "label": "大于"
            },
            {
              "value": "inclusive",
              "label": "大于等于"
            }
          ],
          "default": "strict"
        }
      ]
    }
  },
  "layer": "L3"
}
