file(STRINGS "${ROOT}/VERSION" ASTERION_VERSION LIMIT_COUNT 1)
# The Linux bundle container builds from a source archive without git history.
if(DEFINED ENV{ASTERION_COMMIT})
  set(ASTERION_COMMIT "$ENV{ASTERION_COMMIT}")
else()
  execute_process(COMMAND git -C "${ROOT}" rev-parse --short=12 HEAD
    OUTPUT_VARIABLE ASTERION_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
# What a client and a service must agree on: the schemas of that service's protocol.
function(protocol_hash output)
  set(schemas "")
  foreach(schema IN LISTS ARGN)
    file(READ "${ROOT}/protocol/proto/asterion/${schema}.proto" text)
    string(APPEND schemas "${text}")
  endforeach()
  string(SHA256 hash "${schemas}")
  string(SUBSTRING "${hash}" 0 12 hash)
  set(${output} "${hash}" PARENT_SCOPE)
endfunction()
protocol_hash(ASTERION_QUOTES_PROTOCOL common quotes)
protocol_hash(ASTERION_HISTORY_PROTOCOL common history)
protocol_hash(ASTERION_TRADING_PROTOCOL common strategy trading)
configure_file("${ROOT}/cmake/version.hpp.in" "${OUTPUT}/generated/asterion/version.hpp" @ONLY)
configure_file("${ROOT}/cmake/product.json.in" "${OUTPUT}/product.json" @ONLY)
