# Inspect actual local link targets, including transitive/private dependencies.
# Build-order dependencies (such as bundled resources) do not transfer ownership.
function(asterion_link_closure output root)
  set(pending "${root}")
  set(visited)
  while(pending)
    list(POP_FRONT pending target)
    get_target_property(alias "${target}" ALIASED_TARGET)
    if(alias)
      set(target "${alias}")
    endif()
    if(target IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${target}")
    get_target_property(imported "${target}" IMPORTED)
    if(imported)
      continue()
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(links "${target}" "${property}")
      # Also finds targets inside LINK_ONLY and conditional generator expressions.
      string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*::[A-Za-z0-9_.-]+|[A-Za-z_][A-Za-z0-9_.-]*" candidates "${links}")
      foreach(candidate IN LISTS candidates)
        if(TARGET "${candidate}")
          list(APPEND pending "${candidate}")
        endif()
      endforeach()
    endforeach()
  endwhile()
  set("${output}" "${visited}" PARENT_SCOPE)
endfunction()

function(asterion_check_architecture)
  set(allowed)
  foreach(layer asterion_foundation asterion_kernel asterion_domain)
    list(APPEND allowed "${layer}")
    asterion_link_closure(dependencies "${layer}")
    foreach(dependency IN LISTS dependencies)
      get_target_property(imported "${dependency}" IMPORTED)
      if(NOT imported AND NOT dependency IN_LIST allowed)
        message(FATAL_ERROR "Architecture: ${layer} links upward to ${dependency}")
      endif()
    endforeach()
  endforeach()
  foreach(owner asterion-task-service asterion-node-agent)
    asterion_link_closure(dependencies "${owner}")
    foreach(engine asterion_backtest_engine asterion_factor_engine asterion_paper asterion_strategies)
      if(engine IN_LIST dependencies)
        message(FATAL_ERROR "Architecture: ${owner} must not execute algorithms from ${engine}")
      endif()
    endforeach()
  endforeach()
endfunction()
