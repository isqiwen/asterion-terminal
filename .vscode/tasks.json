{
  // Setup and daily development on macOS and Linux. Release commands: docs/development.md.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare dependencies",
      "detail": "First on a new machine: Conan profile, CTP SDK, pnpm packages, Electron runtime",
      "type": "shell",
      "command": "conan profile detect --exist-ok && python3 scripts/prepare_ctp.py && pnpm install --frozen-lockfile && pnpm exec install-electron",
      "problemMatcher": []
    },
    {
      "label": "Desktop: run",
      "detail": "Build and run the local desktop; Linux service bundle is optional",
      "type": "shell",
      "command": "pnpm desktop",
      "problemMatcher": ["$gcc"],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Desktop: check",
      "detail": "Check the local build, native bridge and analytics resources without opening a window; no Linux service bundle required",
      "type": "shell",
      "command": "pnpm desktop:check",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Check: types, lint, format",
      "type": "shell",
      "command": "pnpm exec tsc --noEmit -p apps/clients/terminal/tsconfig.json && pnpm run lint && pnpm run format:check",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "C++: test",
      "type": "shell",
      "command": "ctest --preset conan-debug --output-on-failure -j 8",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      // Unit and component tests of the UI; no build or service needed.
      "label": "UI: unit tests",
      "type": "shell",
      "command": "pnpm test:unit",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "pnpm run format",
      "problemMatcher": []
    }
  ]
}
