{
  // C++: clangd is the language server and reads the compile database that the
  // desktop build writes; the C/C++ extension is only the debugger.
  "clangd.arguments": ["--compile-commands-dir=build/Debug", "--header-insertion=never"],
  "C_Cpp.intelliSenseEngine": "disabled",
  // CI checks C++ formatting with a pinned clang-format; an editor's own
  // version can format differently. `pnpm run format` is the reference.
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": false
  },

  // CMake presets are generated by Conan: run `pnpm desktop:check` once before
  // using CMake Tools.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,

  // Frontend: the workspace's own TypeScript, and Prettier as locked by pnpm.
  "typescript.tsdk": "node_modules/typescript/lib",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // Not on save: lock files and manifests are JSON that Prettier does not own.
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  "editor.rulers": [100],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": { "files.trimTrailingWhitespace": false },

  // Python writes these beside any script another one imports; they are not
  // sources and stay out of the file tree and search.
  "files.exclude": {
    "**/__pycache__": true
  },
  // Generated trees: several gigabytes that need neither watching nor search.
  "files.watcherExclude": {
    "**/build/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/test-results": true,
    "pnpm-lock.yaml": true
  }
}
