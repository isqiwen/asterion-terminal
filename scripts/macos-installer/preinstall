#!/bin/sh
# Installer runs this before replacing the single system-wide application bundle.
# Only the desktop executable at the managed installation path is affected.
set -eu
pattern='^/Applications/Asterion Terminal[.]app/Contents/MacOS/asterion-terminal( |$)'
if /usr/bin/pgrep -f "$pattern" >/dev/null; then
    /usr/bin/pkill -TERM -f "$pattern" || true
    attempts=0
    while /usr/bin/pgrep -f "$pattern" >/dev/null; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 20 ]; then
            echo 'Asterion Terminal is still running. Quit it before installing.' >&2
            exit 1
        fi
        sleep 1
    done
fi
exit 0
