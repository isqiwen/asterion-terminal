{
  "$defs": {
    "CatalogInput": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "source": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "version_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "checksum",
        "source",
        "version_id"
      ],
      "title": "CatalogInput",
      "type": "object"
    },
    "Contract": {
      "additionalProperties": false,
      "properties": {
        "delivery_month": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "title": "Delivery Month",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "last_delivery_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Delivery On"
        },
        "last_trade_on": {
          "format": "date",
          "title": "Last Trade On",
          "type": "string"
        },
        "listed_on": {
          "format": "date",
          "title": "Listed On",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "delivery_month",
        "id",
        "last_delivery_on",
        "last_trade_on",
        "listed_on",
        "product_id",
        "provenance"
      ],
      "title": "Contract",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "exchange": {
          "enum": [
            "SHFE",
            "DCE",
            "CZCE",
            "CFFEX",
            "INE",
            "GFEX"
          ],
          "title": "Exchange",
          "type": "string"
        },
        "id": {
          "pattern": "^(SHFE|DCE|CZCE|CFFEX|INE|GFEX)\\.[A-Z]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "currency",
        "exchange",
        "id",
        "name",
        "provenance"
      ],
      "title": "Product",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "available_at",
        "observed_at",
        "source",
        "source_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceSymbol": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Symbol",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "provenance",
        "source",
        "symbol",
        "valid_from",
        "valid_until"
      ],
      "title": "SourceSymbol",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contracts": {
      "items": {
        "$ref": "#/$defs/Contract"
      },
      "title": "Contracts",
      "type": "array"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/CatalogInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/Product"
      },
      "title": "Products",
      "type": "array"
    },
    "schema_version": {
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/SourceSymbol"
      },
      "title": "Symbols",
      "type": "array"
    }
  },
  "required": [
    "contracts",
    "inputs",
    "products",
    "schema_version",
    "symbols"
  ],
  "title": "ReferenceCatalog",
  "type": "object"
}
